{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "source/**", "build.py", "README.md", "firestore.*", "artifact.html"],
    "headers": [
      { "source": "firebase-config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
